{
  "name": "codewire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Codewire — five NEC code calculators for electricians, in one fast offline app.",
  "scripts": {
    "dev": "vite",
    "check:api-boundary": "node scripts/check-api-boundary.mjs",
    "prebuild": "npm run check:api-boundary",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:db:concurrency": "node scripts/test-checkout-concurrency.mjs",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^0.456.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "7.18.3",
    "stripe": "22.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "pg": "8.23.0",
    "postcss": "8.5.28",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.66.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "workbox-build": {
      "glob": "13.0.6",
      "source-map": "0.8.0"
    }
  }
}
