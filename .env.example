# Codewire environment variables.
# Copy to .env.local for dev, and set the same keys in Vercel for production.
# The app runs fully (free, offline) WITHOUT any of these — they only enable
# accounts, billing, and cloud sync.

# --- Supabase (client, safe to expose) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase (server only — NEVER expose to the client) ---
# Used by the Stripe webhook + checkout functions to update subscription status.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (server only) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Comma-separated old prices remain mapped after a Stripe price rotation.
STRIPE_PRICE_MONTHLY_LEGACY=
STRIPE_PRICE_YEARLY_LEGACY=

# Optional canonical redirect origin. Production defaults to codewire.tools.
APP_ORIGIN=

# --- Staging smoke test (server only — never set these in production) ---
# Consumed by `npm run test:staging` (scripts/test-staging-environment.mjs).
# That script refuses to run if the app URL or Supabase project is production,
# requires two DIFFERENT throwaway accounts on the staging project, and requires
# Stripe test-mode credentials, so it can never charge a real card.
# Without these the authenticated, cloud-sync and RLS paths cannot be verified
# against a real backend at all.
STAGING_APP_URL=
STAGING_SUPABASE_URL=
STAGING_SUPABASE_ANON_KEY=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
STAGING_TEST_PRO_EMAIL=
STAGING_TEST_PRO_PASSWORD=
STAGING_TEST_FREE_EMAIL=
STAGING_TEST_FREE_PASSWORD=
STAGING_STRIPE_SECRET_KEY=
STAGING_STRIPE_WEBHOOK_SECRET=
STAGING_STRIPE_PRICE_MONTHLY=
STAGING_STRIPE_PRICE_YEARLY=
